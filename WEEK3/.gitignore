# --- Frontend (React) ---
# We add "frontend/" before the paths so Git finds them in your subfolder
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js
frontend/coverage/
frontend/build/

# --- Backend (Python/Member 1) ---
# Prevents pushing the heavy virtual environment and cache
backend/venv/
backend/env/
backend/__pycache__/
backend/*.pyc

# --- Environment & Misc ---
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
